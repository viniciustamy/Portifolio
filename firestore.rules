rules_version = '2';

// Analytics do portfólio: qualquer visitante grava uma visita ou um clique, no formato certo.
// Por enquanto a leitura é aberta (o painel /analytics não tem login; os dados são só contagens anônimas).
// Ninguém apaga, e a visita só aceita atualizar o tempo e a rolagem.
service cloud.firestore {
  match /databases/{database}/documents {
    function shortString(v, max) {
      return v is string && v.size() > 0 && v.size() <= max;
    }

    match /views/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['path', 'caseId', 'source', 'device', 'sid', 'seconds', 'scroll', 'ts'])
        && shortString(request.resource.data.path, 200)
        && (request.resource.data.caseId == null || shortString(request.resource.data.caseId, 80))
        && shortString(request.resource.data.source, 80)
        && request.resource.data.device in ['Celular', 'Tablet', 'Desktop']
        && shortString(request.resource.data.sid, 20)
        && request.resource.data.seconds == 0
        && request.resource.data.scroll == 0
        && request.resource.data.ts == request.time;
      // Só tempo e rolagem mudam, e só durante a hora seguinte à visita
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seconds', 'scroll'])
        && request.resource.data.seconds is int && request.resource.data.seconds >= resource.data.seconds && request.resource.data.seconds <= 3600
        && request.resource.data.scroll is int && request.resource.data.scroll >= 0 && request.resource.data.scroll <= 100
        && request.time < resource.data.ts + duration.value(1, 'h');
    }

    match /clicks/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['label', 'path', 'sid', 'ts'])
        && shortString(request.resource.data.label, 80)
        && shortString(request.resource.data.path, 200)
        && shortString(request.resource.data.sid, 20)
        && request.resource.data.ts == request.time;
    }
  }
}
